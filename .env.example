# Copy to .env.local. All values are validated by src/config/env.ts.

# "enabled" runs the in-repo mock API (server-side MSW handlers) at /api/*.
# Build-time flag: production builds MUST use "disabled" so demo accounts and
# the scenario switcher are not bundled.
NEXT_PUBLIC_API_MOCKING=enabled

# Booth (shared device) mode: idle timeout + auto sign-out. Default true.
NEXT_PUBLIC_BOOTH_MODE=true

# Real backend base URL. Used only when NEXT_PUBLIC_API_MOCKING=disabled.
# The browser always calls same-origin /api/*; Next rewrites it here.
# API_BASE_URL=https://api.pilketum.bcc.example/v1
