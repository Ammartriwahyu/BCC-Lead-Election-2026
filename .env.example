# Copy to .env.local. All values are validated by src/config/env.ts.

# "enabled" runs the in-repo mock API (server-side MSW handlers) at /api/*.
# Build-time flag: production builds MUST use "disabled" so demo accounts and
# the scenario switcher are not bundled.
NEXT_PUBLIC_API_MOCKING=enabled

# Booth (shared device) mode: idle timeout + auto sign-out. Default true.
NEXT_PUBLIC_BOOTH_MODE=true

# Backend base URL WITHOUT /api. Used only when NEXT_PUBLIC_API_MOCKING=disabled. The browser
# calls same-origin /api/*; the Next server (src/lib/bff) forwards to API_BASE_URL + /api/* with
# the Bearer token from the session cookie. Read at runtime.
# API_BASE_URL=https://pilketum.bccdev.id/staging     (staging)
# API_BASE_URL=https://pilketum.bccdev.id             (production)

# Secret for the X-BFF-Secret header, from the backend team; one per environment. Server-only:
# never commit it and never give it a NEXT_PUBLIC_ name. With it the backend trusts X-Client-IP,
# so its per-IP rate limits see each voter instead of this server.
# BFF_SECRET=

# Proxies in front of the Next server that append to X-Forwarded-For (nginx alone: 1).
# TRUSTED_PROXY_HOPS=1

# Hosts candidate photos may come from (next/image), comma-separated URL patterns. Build time.
# IMAGE_REMOTE_PATTERNS=https://pilketum.bccdev.id/**

# Names of the httpOnly cookies in which the Next server keeps the backend tokens.
# src/proxy.ts only checks that the right one exists. Read at runtime. Defaults shown.
# SESSION_COOKIE_VOTER=pilketum_voter_session
# SESSION_COOKIE_ADMIN=pilketum_admin_session
